# Copy to .env and fill in. Never commit .env.

# Required for Tier 2 and Tier 3 (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# Tier 1 (local Ollama). Inside Docker this becomes http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
# Switch to llama3.2:1b for a faster, weaker Tier 1
OLLAMA_MODEL=llama3.2:3b

# Tier 3 thinking mode (slower, more expensive: reasoning tokens are billed as output)
DEEPSEEK_PRO_THINKING=false
